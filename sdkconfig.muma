# Selecao do board para build manual no Windows, onde scripts/build.py nao roda
# sem a correcao do shutil.which (ver docs/build-windows-cli.md).
CONFIG_BOARD_TYPE_SPOTPEAR_ESP32_S3_1_54_MUMA=y

# ⚠️ EXPERIMENTO 07/09/2026: palavra de despertar PRE-TREINADA (WakeNet) no lugar do
#    MultiNet. O MultiNet e um reconhecedor de COMANDOS usado como despertar, e por isso
#    dispara ~6x por minuto com o teclado; o WakeNet e treinado para uma palavra so e, na
#    mesma sala e mesmo teclado, o 你好小智 embutido nao dispara nenhuma vez.
#    Ver doc/wake-word-fatos-verificados.md secao 4-C.
#
# ⚠️ O PRECO: o aparelho deixa de atender por "ok annia" e passa a atender por "Sophia".
CONFIG_USE_AFE_WAKE_WORD=y

# ⚠️ EXPERIMENTO 11/09/2026 (2a rodada): WakeNet10 com o pipeline de assets CORRIGIDO.
#
#    A 1a rodada (08/09) concluiu que o esp-sr 2.5.3 distribuia os modelos WN10 com sufixo
#    _p1/_p2 e os procurava sem sufixo -- "inconsistencia do pacote, sem conserto deste
#    lado". ESTAVA ERRADO, e a Espressif explicou no esp-sr#242 (comentario 5633472245):
#
#      - _p1 = esp32s3 (PIEv1), _p2 = esp32p4/esp32s31 (PIEv2). Os dois vem no pacote.
#      - model/movemodel.py (copy_wn10_model) escolhe o do alvo NA BUILD e renomeia
#        wn10_data_p1 -> wn10_data, _MODEL_INFO_p1 -> _MODEL_INFO_, descartando o outro.
#
#    O movemodel.py nunca rodou aqui: o esp-sr so o chama quando a tabela de particoes tem
#    uma particao "model" (esp-sr/CMakeLists.txt:103), e a nossa (partitions/v2/16m.csv) nao
#    tem. O Xiaozhi monta o srmodels.bin sozinho, em scripts/build_default_assets.py, com
#    um shutil.copytree cru do diretorio do modelo (:150 e :176) -- porte parcial do
#    movemodel.py de antes do WN10 existir. Por isso a tabela da secao 4-F mostrava
#    wn10_data_p1/_p2 COM sufixo dentro do generated_assets.bin.
#
#    CORRIGIDO em scripts/build_default_assets.py: copy_wn10_model portado, selecao por
#    CONFIG_IDF_TARGET. Provado em unidade contra o modelo real antes de compilar.
#
#    ⚠️ CONTINUA VALENDO: nao confie na linha "detector: WakeNet" do boot -- ela sai igual
#    com o modelo quebrado. So vale o AFE Pipeline conter |WakeNet(<nome>,)|.
#    ⚠️ E o esp-sr 2.5.3 engorda o app em +1062 KB (esp-dl), deixando ~3,9% na ota_0.
#
#    Detalhes em AnniaVox: doc/wake-word-fatos-verificados.md secoes 4-F e 4-G.
CONFIG_SR_WN_WN9_SOPHIA_TTS=n
CONFIG_SR_WN_WN10_HEYNOVA=y

# O modelo MultiNet fica no assets mesmo sem ser usado como despertar: e o que permite
# voltar para uma palavra propria depois, sem recompilar.
CONFIG_SR_MN_EN_MULTINET6_QUANT=y

# Idioma da tela e dos prompts. pt-BR foi criado neste fork a partir do pt-PT.
CONFIG_LANGUAGE_PT_BR=y

# ⚠️ TIRA o 你好小智, que o sdkconfig.defaults.esp32s3 do repositorio liga por padrao.
#    Com dois modelos WakeNet no assets, o firmware escolhe com
#    esp_srmodel_filter(models_, ESP_WN_PREFIX, nullptr) -- o PRIMEIRO que achar, sem
#    criterio nosso. O teste da Sophia poderia acabar medindo a palavra chinesa.
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
